{
  "name": "color-keepsakes",
  "version": "1.0.0",
  "description": "Photo-inspired color palettes on an interactive postcard rack.",
  "license": "MIT",
  "author": "Hoyin Wan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoyinwan07/color-keepsakes.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "images": "node --experimental-strip-types scripts/optimize-images.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
